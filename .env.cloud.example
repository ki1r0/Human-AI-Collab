# Copy this file to .env.cloud on the cloud GPU host.
ISAACLAB_BASE_IMAGE=nvcr.io/nvidia/isaac-lab:2.3.0
HAC_IMAGE_NAME=human-ai-collab:cloud

# Required. Use the cloud VM's public IPv4 address.
PUBLIC_IP=

# Required. Keep this file private and never commit it.
COMMANDER_API_KEY=
COMMANDER_LLM_MODEL=gemini-2.5-flash

# Optional integrations.
COSMOS_BASE_URL=
COSMOS_CHAT_COMPLETIONS_URL=
COSMOS_MODEL=/models/Cosmos-Reason2-8B
COSMOS_API_KEY=
COSMOS_TIMEOUT=60
MEM0_API_KEY=

# Runtime defaults.
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all
ACCEPT_EULA=Y
PRIVACY_CONSENT=Y
OMNI_KIT_ACCEPT_EULA=Y
ISAACLAB_ROOT=/isaac-sim
ISAACLAB_LAUNCHER=
HAC_PREFER_LOCAL_SCENE_ASSETS=1
HAC_AUTO_DOWNLOAD_SCENE_ASSETS=0
HAC_ENABLE_ROOM_SHELL_FALLBACK=0
