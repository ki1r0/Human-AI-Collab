# Reproducible M1 full pick→transport→place calibration candidate.
# This is deliberately separate from the launcher defaults: friction and
# support-collision withdrawal are material/fixture ablations, not hidden
# baseline changes.  Run with: set -a; . this file; set +a; bash tools/run_m1_isaac_strict_success.sh
M1_GPU_DEVICE=2
M1_NO_VIDEO=0
M1_HEADLESS=1
M1_CONTROLLED_PLACE=1
M1_RETRACT_STAGING_SUPPORTS=1
M1_STAGING_SUPPORT_WITHDRAW_MODE=disable_collision
M1_GRIP_OPENING=.005
M1_RELEASE_OPENING=.05
M1_GRIPPER_STATIC_FRICTION=10.0
M1_GRIPPER_DYNAMIC_FRICTION=8.0
M1_STAGING_SUPPORT_DROP_M=.05
M1_STAGING_SUPPORT_RETRACT_STEPS=1
M1_LIFT_SEGMENTS=8
M1_LIFT_SEGMENT_STEPS=30
M1_INSERTION_SEGMENTS=8
M1_INSERTION_SEGMENT_STEPS=40
M1_TRANSPORT_CLEARANCE_Z=.30
M1_TRANSPORT_SIDE_CLEARANCE_Y=0
M1_TRANSPORT_SIDE_OFFSET_X=-.40
M1_INSERT_SAFE_WAYPOINT=1
M1_CLOSED_LOOP_INSERTION=1
M1_PRESERVE_LIFT_GRASP_FRAME=1
M1_FOLLOW_LINK_ORIENTATION=1
M1_ROTATE_HELD_ORIENTATION=1
M1_PLACE_ACCEPTANCE=1
M1_STRICT_ACCEPTANCE=0
M1_TRACK_TIP_CONTACT=0
