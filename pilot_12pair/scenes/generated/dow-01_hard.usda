#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    custom string task:render_collision_contract = "shared mutation parameters"
    custom string task:task_id = "DOW-01"
    custom string task:variant = "HARD"

    def PhysicsScene "physicsScene"
    {
    }

    def "Looks"
    {
        def Material "MutationFeature"
        {
            token outputs:surface.connect = </World/Looks/MutationFeature/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.48, 0.52)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
    }

    def Xform "parts"
    {
        def Xform "Casing_Base"
        {
            float3 xformOp:scale = (0.001, 0.001, 0.001)
            double3 xformOp:translate = (0, 0, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

            def Xform "Asset" (
                prepend references = @../../../assets/parts/Casing Base.usd@
            )
            {
            }
        }

        def Xform "Casing_Top"
        {
            float3 xformOp:scale = (0.001, 0.001, 0.001)
            double3 xformOp:translate = (0.22, 0, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

            def Xform "Asset" (
                prepend references = @../../../assets/parts/Casing Top.usd@
            )
            {
            }
        }

        def Xform "Dowel_Pin"
        {
            float3 xformOp:scale = (0.001, 0.001, 0.001)
            double3 xformOp:translate = (0.44, 0, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

            def Xform "Asset" (
                prepend references = @../../../assets/CAD_edit/Dowel Pin_rescaled.usd@
            )
            {
            }
        }
    }

    def Xform "mutation_fixture"
    {
        def Cube "slot_left" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/Looks/MutationFeature>
            color3f[] primvars:displayColor = [(0.42, 0.48, 0.52)]
            double size = 1
            float3 xformOp:scale = (0.006, 0.0218, 0.008)
            double3 xformOp:translate = (-0.0094, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "slot_right" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/Looks/MutationFeature>
            color3f[] primvars:displayColor = [(0.42, 0.48, 0.52)]
            double size = 1
            float3 xformOp:scale = (0.006, 0.0218, 0.008)
            double3 xformOp:translate = (0.0094, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}

