{
  "model_id": "robbyant/lingbot-va-base",
  "official_repo": "https://github.com/robbyant/lingbot-va",
  "official_repo_revision": "7c6ffa9",
  "checkpoint": "https://huggingface.co/robbyant/lingbot-va-base",
  "runtime": {
    "conda_environment": "lingbot-va",
    "python": "3.10.16",
    "torch": "2.9.0+cu126",
    "diffusers": "0.36.0",
    "transformers": "4.55.2",
    "attention_mode": "torch",
    "offload_vae_and_text_encoder": true,
    "single_gpu_vram_target_gb": 18
  },
  "interface": {
    "config": "franka_i2va",
    "input_cameras": [
      "observation.images.cam_high",
      "observation.images.cam_left_wrist",
      "observation.images.cam_right_wrist"
    ],
    "action_layout": "30-dim multi-embodiment layout; Franka config selects Cartesian EEF/gripper channels",
    "default_chunks": 1,
    "video_inference_steps": 5,
    "action_inference_steps": 10
  },
  "scientific_status": "deployment and native-output smoke baseline; not a custom-embodiment success evaluation"
}
